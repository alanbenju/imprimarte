{
  "name": "customia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "npx browserslist@latest --update-db && next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "eslint --fix \"**/*.{js,jsx,ts,tsx}\"",
    "fix-styles": "npm run format && npm run lint:fix",
    "mikro-orm": "npx mikro-orm",
    "migration:create": "mikro-orm migration:create --config=src/app/api/database/mikro-orm.config.ts",
    "migration:up": "mikro-orm migration:up --config=src/app/api/database/mikro-orm.config.ts",
    "migration:down": "mikro-orm migration:down --config=src/app/api/database/mikro-orm.config.ts",
    "migration:pending": "mikro-orm migration:pending --config=src/app/api/database/mikro-orm.config.ts",
    "migration:run": "node scripts/run-migration.js",
    "schema:fresh": "mikro-orm schema:fresh --run --config=src/app/api/database/mikro-orm.config.ts",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "db:fresh": "npm run docker:down && docker volume rm customia_postgres_data customia_pgadmin_data && npm run docker:up"
  },
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.0.15",
    "@mapbox/node-pre-gyp": "^1.0.11",
    "@mercadopago/sdk-react": "^0.0.19",
    "@mikro-orm/cli": "^6.4.9",
    "@mikro-orm/core": "^6.4.9",
    "@mikro-orm/migrations": "^6.4.9",
    "@mikro-orm/postgresql": "^6.4.9",
    "@mikro-orm/reflection": "^6.4.9",
    "@next/font": "^14.2.5",
    "@radix-ui/react-dropdown-menu": "^2.1.14",
    "@radix-ui/react-select": "^2.2.4",
    "@supabase/supabase-js": "^2.45.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.9",
    "axios": "^1.7.4",
    "bcryptjs": "^3.0.2",
    "canvas": "^2.11.2",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.5.2",
    "firebase": "^10.13.0",
    "firebase-admin": "^12.7.0",
    "formidable": "^3.5.1",
    "jsonwebtoken": "^9.0.2",
    "konva": "^9.3.14",
    "lucide-react": "^0.429.0",
    "mercadopago": "^2.0.15",
    "next": "14.2.5",
    "react": "^18",
    "react-dom": "^18",
    "react-icons": "^5.3.0",
    "react-konva": "^18.2.10",
    "react-konva-utils": "^1.0.6",
    "react-moveable": "^0.56.0",
    "tailwind-merge": "^3.3.0",
    "use-image": "^1.1.1",
    "uuid": "^10.0.0",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@mikro-orm/sql-highlighter": "^1.0.1",
    "@types/formidable": "^3.4.5",
    "@types/node": "^22.4.0",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8",
    "eslint-config-next": "14.2.5",
    "eslint-plugin-tailwindcss": "^3.18.0",
    "postcss": "^8.4.41",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "source-map-support": "^0.5.21",
    "tailwindcss": "^3.4.10",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  },
  "mikro-orm": {
    "useTsNode": true,
    "configPaths": [
      "./src/app/api/database/mikro-orm.config.ts"
    ]
  }
}
